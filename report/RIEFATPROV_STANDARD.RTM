  object raCodeModule1: TraCodeModule
    object raProgramInfo1: TraProgramInfo
      raClassName = 'TraEventHandler'
      raProgram.ProgramName = 'Variable1OnCalc'
      raProgram.ProgramType = ttProcedure
      raProgram.Source = 
        'procedure Variable1OnCalc(var Value: Variant);'#13#10'begin'#13#10'  Value :' +
        '= variable1.asdouble + DBTabella['#39'fvt_importo_totale'#39']'#13#10#13#10'end;'#13#10
      raProgram.ComponentName = 'Variable1'
      raProgram.EventName = 'OnCalc'
      raProgram.EventID = 33
    end
    object raProgramInfo2: TraProgramInfo
      raClassName = 'TraEventHandler'
      raProgram.ProgramName = 'Variable2OnCalc'
      raProgram.ProgramType = ttProcedure
      raProgram.Source = 
        'procedure Variable2OnCalc(var Value: Variant);'#13#10'begin'#13#10#13#10'  Value' +
        ' := DBTabella['#39'fat_importo_totale_imponibile'#39'] - DBTabella['#39'impo' +
        'rto_ritenuta_percipienti'#39']'#13#10#13#10'end;'#13#10
      raProgram.ComponentName = 'Variable2'
      raProgram.EventName = 'OnCalc'
      raProgram.EventID = 33
    end
    object raProgramInfo3: TraProgramInfo
      raClassName = 'TraEventHandler'
      raProgram.ProgramName = 'Variable3OnCalc'
      raProgram.ProgramType = ttProcedure
      raProgram.Source = 
        'procedure Variable3OnCalc(var Value: Variant);'#13#10'begin'#13#10#13#10'  Value' +
        ' := variable1.value - variable2.value'#13#10#13#10'end;'#13#10
      raProgram.ComponentName = 'Variable3'
      raProgram.EventName = 'OnCalc'
      raProgram.EventID = 33
    end
    object raProgramInfo4: TraProgramInfo
      raClassName = 'TraEventHandler'
      raProgram.ProgramName = 'Variable4OnCalc'
      raProgram.ProgramType = ttProcedure
      raProgram.Source = 
        'procedure Variable4OnCalc(var Value: Variant);'#13#10'begin'#13#10#13#10'  Value' +
        ' := variable4.value + variable1.value;'#13#10#13#10'end;'#13#10
      raProgram.ComponentName = 'Variable4'
      raProgram.EventName = 'OnCalc'
      raProgram.EventID = 33
    end
    object raProgramInfo5: TraProgramInfo
      raClassName = 'TraEventHandler'
      raProgram.ProgramName = 'Variable5OnCalc'
      raProgram.ProgramType = ttProcedure
      raProgram.Source = 
        'procedure Variable5OnCalc(var Value: Variant);'#13#10'begin'#13#10' '#13#10'  Valu' +
        'e := variable5.value + variable2.value;'#13#10#13#10'end;'#13#10
      raProgram.ComponentName = 'Variable5'
      raProgram.EventName = 'OnCalc'
      raProgram.EventID = 33
    end
    object raProgramInfo6: TraProgramInfo
      raClassName = 'TraEventHandler'
      raProgram.ProgramName = 'Variable6OnCalc'
      raProgram.ProgramType = ttProcedure
      raProgram.Source = 
        'procedure Variable6OnCalc(var Value: Variant);'#13#10'begin'#13#10#13#10'  Value' +
        ' := variable4.value - variable5.value'#13#10#13#10'end;'#13#10
      raProgram.ComponentName = 'Variable6'
      raProgram.EventName = 'OnCalc'
      raProgram.EventID = 33
    end
    object raProgramInfo7: TraProgramInfo
      raClassName = 'TraEventHandler'
      raProgram.ProgramName = 'Variable9OnCalc'
      raProgram.ProgramType = ttProcedure
      raProgram.Source = 
        'procedure Variable9OnCalc(var Value: Variant);'#13#10'begin'#13#10#13#10'  Value' +
        ' := DBTabella['#39'importo_provvigioni'#39'] * (100 - DBTabella['#39'abbatti' +
        'mento_irpef'#39']) * DBTabella['#39'percentuale_ritenuta'#39'] / 10000'#13#10#13#10'en' +
        'd;'#13#10
      raProgram.ComponentName = 'Variable9'
      raProgram.EventName = 'OnCalc'
      raProgram.EventID = 33
    end
    object raProgramInfo8: TraProgramInfo
      raClassName = 'TraEventHandler'
      raProgram.ProgramName = 'Variable8OnCalc'
      raProgram.ProgramType = ttProcedure
      raProgram.Source = 
        'procedure Variable8OnCalc(var Value: Variant);'#13#10'begin'#13#10#13#10'  Value' +
        ' := DBTabella['#39'importo_provvigioni'#39'] - variable9.value'#13#10#13#10'end;'#13#10
      raProgram.ComponentName = 'Variable8'
      raProgram.EventName = 'OnCalc'
      raProgram.EventID = 33
    end
    object raProgramInfo9: TraProgramInfo
      raClassName = 'TraEventHandler'
      raProgram.ProgramName = 'Variable7OnCalc'
      raProgram.ProgramType = ttProcedure
      raProgram.Source = 
        'procedure Variable7OnCalc(var Value: Variant);'#13#10'begin'#13#10#13#10'  Value' +
        ' := variable8.value * 100 / DBTabella['#39'fvt_importo_totale'#39']'#13#10#13#10'e' +
        'nd;'#13#10
      raProgram.ComponentName = 'Variable7'
      raProgram.EventName = 'OnCalc'
      raProgram.EventID = 33
    end
  end
