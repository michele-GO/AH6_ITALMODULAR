  object raCodeModule1: TraCodeModule
    object raProgramInfo1: TraProgramInfo
      raClassName = 'TraEventHandler'
      raProgram.ProgramName = 'numeratoreOnCalc'
      raProgram.ProgramType = ttProcedure
      raProgram.Source = 
        'procedure numeratoreOnCalc(var Value: Variant);'#13#10'begin'#13#10#13#10'  Valu' +
        'e := value + 1'#13#10#13#10'end;'#13#10
      raProgram.ComponentName = 'numeratore'
      raProgram.EventName = 'OnCalc'
      raProgram.EventID = 33
    end
    object raProgramInfo2: TraProgramInfo
      raClassName = 'TraEventHandler'
      raProgram.ProgramName = 'unitaOnCalc'
      raProgram.ProgramType = ttProcedure
      raProgram.Source = 
        'procedure unitaOnCalc(var Value: Variant);'#13#10'begin'#13#10#13#10'  Value := ' +
        'numeratore.value mod 10;'#13#10#13#10'end;'#13#10
      raProgram.ComponentName = 'unita'
      raProgram.EventName = 'OnCalc'
      raProgram.EventID = 33
    end
    object raProgramInfo3: TraProgramInfo
      raClassName = 'TraEventHandler'
      raProgram.ProgramName = 'decineOnCalc'
      raProgram.ProgramType = ttProcedure
      raProgram.Source = 
        'procedure decineOnCalc(var Value: Variant);'#13#10'begin'#13#10#13#10'  Value :=' +
        ' (numeratore.value - unita.value) / 10; '#13#10#13#10'end;'#13#10
      raProgram.ComponentName = 'decine'
      raProgram.EventName = 'OnCalc'
      raProgram.EventID = 33
    end
  end
