	dxSpreadSheetFunctionsStrs_sfnSumSQ,	L"SUMSQ"
	dxSpreadSheetFunctionsStrs_sfnSumSQDescription,	L"Sums the squares of values in a series of numbers."
	dxSpreadSheetFunctionsStrs_sfnSumX2MY2,	L"SUMX2MY2"
	dxSpreadSheetFunctionsStrs_sfnSumX2MY2Description,	L"Sums the differences of the corresponding squared values in two specified arrays."
	dxSpreadSheetFunctionsStrs_sfnSumX2PY2,	L"SUMX2PY2"
	dxSpreadSheetFunctionsStrs_sfnSumX2PY2Description,	L"Sums the sums of the corresponding squared values in two specified arrays."
	dxSpreadSheetFunctionsStrs_sfnSumXMY2,	L"SUMXMY2"
	dxSpreadSheetFunctionsStrs_sfnSumXMY2Description,	L"Sums the squares of differences of the corresponding values in two specified arrays."
	dxSpreadSheetFunctionsStrs_sfnTan,	L"TAN"
	dxSpreadSheetFunctionsStrs_sfnTanDescription,	L"Returns the tangent."
	dxSpreadSheetFunctionsStrs_sfnSeriesSum,	L"SERIESSUM"
	dxSpreadSheetFunctionsStrs_sfnSeriesSumDescription,	L"Returns the sum of a power series based on the specified set of coefficients."
	dxSpreadSheetFunctionsStrs_sfnSign,	L"SIGN"
	dxSpreadSheetFunctionsStrs_sfnSignDescription,	L"Returns the specified number\x2019s sign."
	dxSpreadSheetFunctionsStrs_sfnSin,	L"SIN"
	dxSpreadSheetFunctionsStrs_sfnSinDescription,	L"Returns the sine."
	dxSpreadSheetFunctionsStrs_sfnSinh,	L"SINH"
	dxSpreadSheetFunctionsStrs_sfnSinhDescription,	L"Returns the hyperbolic sine."
	dxSpreadSheetFunctionsStrs_sfnSqrt,	L"SQRT"
	dxSpreadSheetFunctionsStrs_sfnSqrtDescription,	L"Returns the square root."
	dxSpreadSheetFunctionsStrs_sfnSqrtPi,	L"SQRTPI"
	dxSpreadSheetFunctionsStrs_sfnSqrtPiDescription,	L"Returns the square root of Pi multiplied by the specified value."
	dxSpreadSheetFunctionsStrs_sfnSubTotal,	L"SUBTOTAL"
	dxSpreadSheetFunctionsStrs_sfnSubTotalDescription,	L"Returns a subtotal."
	dxSpreadSheetFunctionsStrs_sfnSum,	L"SUM"
	dxSpreadSheetFunctionsStrs_sfnSumDescription,	L"Sums all the specified numeric values."
	dxSpreadSheetFunctionsStrs_sfnRand,	L"RAND"
	dxSpreadSheetFunctionsStrs_sfnRandDescription,	L"Returns a random number within the range between 0 and 1, inclusive."
	dxSpreadSheetFunctionsStrs_sfnRandBetween,	L"RANDBETWEEN"
	dxSpreadSheetFunctionsStrs_sfnRandBetweenDescription,	L"Returns a random integer within the specified range."
	dxSpreadSheetFunctionsStrs_sfnRoman,	L"ROMAN"
	dxSpreadSheetFunctionsStrs_sfnRomanDescription,	L"Converts an Arabic numeral to a Roman numeral (as a text string)."
	dxSpreadSheetFunctionsStrs_sfnRound,	L"ROUND"
	dxSpreadSheetFunctionsStrs_sfnRoundDescription,	L"Rounds a numeric value to the specified number of digits."
	dxSpreadSheetFunctionsStrs_sfnRoundDown,	L"ROUNDDOWN"
	dxSpreadSheetFunctionsStrs_sfnRoundDownDescription,	L"Rounds a numeric value towards zero."
	dxSpreadSheetFunctionsStrs_sfnRoundUp,	L"ROUNDUP"
	dxSpreadSheetFunctionsStrs_sfnRoundUpDescription,	L"Rounds a numeric value towards infinity."
	dxSpreadSheetFunctionsStrs_sfnSec,	L"SEC"
	dxSpreadSheetFunctionsStrs_sfnSecDescription,	L"Returns the secant."
	dxSpreadSheetFunctionsStrs_sfnSech,	L"SECH"
	dxSpreadSheetFunctionsStrs_sfnSechDescription,	L"Returns the hyperbolic secant."
	dxSpreadSheetFunctionsStrs_sfnMultiNomial,	L"MULTINOMIAL"
	dxSpreadSheetFunctionsStrs_sfnMultiNomialDescription,	L"Returns the multinomial of a set of numbers."
	dxSpreadSheetFunctionsStrs_sfnMUnit,	L"MUNIT"
	dxSpreadSheetFunctionsStrs_sfnMUnitDescription,	L"Returns the unit matrix for the  specified dimension."
	dxSpreadSheetFunctionsStrs_sfnOdd,	L"ODD"
	dxSpreadSheetFunctionsStrs_sfnOddDescription,	L"Rounds the numeric value up to the nearest integer."
	dxSpreadSheetFunctionsStrs_sfnPi,	L"PI"
	dxSpreadSheetFunctionsStrs_sfnPiDescription,	L"Returns the value of Pi."
	dxSpreadSheetFunctionsStrs_sfnPower,	L"POWER"
	dxSpreadSheetFunctionsStrs_sfnPowerDescription,	L"Raises the numeric value to the specified power."
	dxSpreadSheetFunctionsStrs_sfnProduct,	L"PRODUCT"
	dxSpreadSheetFunctionsStrs_sfnProductDescription,	L"Multiplies all the parameter values and returns the product."
	dxSpreadSheetFunctionsStrs_sfnQuotient,	L"QUOTIENT"
	dxSpreadSheetFunctionsStrs_sfnQuotientDescription,	L"Discards the remainder of a division and returns its integer portion."
	dxSpreadSheetFunctionsStrs_sfnRadians,	L"RADIANS"
	dxSpreadSheetFunctionsStrs_sfnRadiansDescription,	L"Converts degrees to radians."
	dxSpreadSheetFunctionsStrs_sfnLn,	L"LN"
	dxSpreadSheetFunctionsStrs_sfnLnDescription,	L"Returns the natural logarithm."
	dxSpreadSheetFunctionsStrs_sfnLog,	L"LOG"
	dxSpreadSheetFunctionsStrs_sfnLogDescription,	L"Returns the value\x2019s logarithm to the specified base."
	dxSpreadSheetFunctionsStrs_sfnLog10,	L"LOG10"
	dxSpreadSheetFunctionsStrs_sfnLog10Description,	L"Returns the value\x2019s base-10 logarithm."
	dxSpreadSheetFunctionsStrs_sfnMDeterm,	L"MDETERM"
	dxSpreadSheetFunctionsStrs_sfnMDetermDescription,	L"Calculates the determinant for the specified matrix."
	dxSpreadSheetFunctionsStrs_sfnMInverse,	L"MINVERSE"
	dxSpreadSheetFunctionsStrs_sfnMInverseDescription,	L"Returns the inverse matrix for the matrix stored in the specified array."
	dxSpreadSheetFunctionsStrs_sfnMMult,	L"MMULT"
	dxSpreadSheetFunctionsStrs_sfnMMultDescription,	L"Returns the matrix product of two arrays."
	dxSpreadSheetFunctionsStrs_sfnMod,	L"MOD"
	dxSpreadSheetFunctionsStrs_sfnModDescription,	L"Returns the remainder after one specified number is divided by the other."
	dxSpreadSheetFunctionsStrs_sfnMRound,	L"MROUND"
	dxSpreadSheetFunctionsStrs_sfnMRoundDescription,	L"Rounds a numeric value to the specified multiple."
	dxSpreadSheetFunctionsStrs_sfnFactDouble,	L"FACTDOUBLE"
	dxSpreadSheetFunctionsStrs_sfnFactDoubleDescription,	L"Returns the double factorial."
	dxSpreadSheetFunctionsStrs_sfnFloor,	L"FLOOR"
	dxSpreadSheetFunctionsStrs_sfnFloorDescription,	L"Rounds the value down to the nearest multiple of the specified significance."
	dxSpreadSheetFunctionsStrs_sfnFloor_Math,	L"FLOOR.MATH"
	dxSpreadSheetFunctionsStrs_sfnFloor_MathDescription,	L"Rounds the number down to the nearest integer or to the nearest multiple of significance."
	dxSpreadSheetFunctionsStrs_sfnFloor_Precise,	L"FLOOR.PRECISE"
