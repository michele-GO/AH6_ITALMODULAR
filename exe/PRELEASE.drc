	dxSpreadSheetFunctionsStrs_sfnGCD,	L"GCD"
	dxSpreadSheetFunctionsStrs_sfnGCDDescription,	L"Returns the greatest common divisor of two or more integer values."
	dxSpreadSheetFunctionsStrs_sfnInt,	L"INT"
	dxSpreadSheetFunctionsStrs_sfnIntDescription,	L"Rounds the value down to the nearest integer."
	dxSpreadSheetFunctionsStrs_sfnIso_Ceiling,	L"ISO.CEILING"
	dxSpreadSheetFunctionsStrs_sfnIso_CeilingDescription,	L"Rounds the value up to the nearest integer or to the nearest multiple of significance. The function always rounds the specified numeric value up."
	dxSpreadSheetFunctionsStrs_sfnLCM,	L"LCM"
	dxSpreadSheetFunctionsStrs_sfnLCMDescription,	L"Returns the least common multiple of integer values."
